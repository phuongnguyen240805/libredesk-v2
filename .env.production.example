# =========================
# Docker Compose / host ports
# =========================
COMPOSE_PROJECT_NAME=libredesk-prod

# 127.0.0.1 = only reverse proxy / local host can access these ports.
# Use 0.0.0.0 only if you intentionally want to expose them publicly.
BIND_IP=127.0.0.1
LIBREDESK_HOST_PORT=9001
ZALO_HOST_PORT=3100
FACEBOOK_HOST_PORT=3200

# Shared Docker network with liora-monorepo.
LIORA_PLATFORM_NETWORK=liora-platform

# =========================
# LibreDesk
# =========================
LIBREDESK_IMAGE=libredesk-prod:latest
LIBREDESK_VERSION=production
LIBREDESK_BUILD=production

# Exactly 32 chars recommended. Example generation:
# Linux: openssl rand -hex 16
# PowerShell: [guid]::NewGuid().ToString("N")
LIBREDESK_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_ENCRYPTION_KEY

# Optional on first boot. You can also set it later with:
# docker compose --env-file .env.production -f docker-compose.production.yml exec app ./libredesk --set-system-user-password
LIBREDESK_SYSTEM_USER_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# =========================
# PostgreSQL (internal only, no host port)
# =========================
POSTGRES_USER=libredesk
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=libredesk

# =========================
# Zalo connector
# =========================
ZALO_CONNECTOR_IMAGE=libredesk-zalo-connector:prod
ZALO_ACCOUNT_ID=demo-zalo
ZALO_CONNECTOR_TOKEN=CHANGE_ME_AT_LEAST_24_CHARS_ZALO_TOKEN

# When liora and libredesk are on the same Docker host/network:
CUSTOMER_CARE_WEBHOOK_URL=http://liora-ladipage:7002/api/internal/customer-care/zalo/events
CUSTOMER_CARE_WEBHOOK_SECRET=CHANGE_ME_AT_LEAST_24_CHARS_WEBHOOK_SECRET
CUSTOMER_CARE_TENANT_ID=1
INBOUND_RETRY_COUNT=5
INBOUND_RETRY_BASE_MS=1000

# =========================
# Facebook connector
# =========================
FACEBOOK_CONNECTOR_IMAGE=libredesk-facebook-connector:prod
FACEBOOK_ACCOUNT_ID=demo-facebook
FACEBOOK_CONNECTOR_TOKEN=CHANGE_ME_AT_LEAST_24_CHARS_FACEBOOK_TOKEN
CUSTOMER_CARE_FACEBOOK_WEBHOOK_URL=http://liora-ladipage:7002/api/internal/customer-care

# Facebook bridge source tag from babyvibe/deplao-builder.
DEPLAO_REF=v26.8.2
