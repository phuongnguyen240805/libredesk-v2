FROM golang:1.25-bookworm AS bridge-builder

ARG DEPLAO_REF=v26.8.2
ARG MAUTRIX_META_REF=f3bfc5474e2a3bc772ace1cddf591bb9cf60a318

ENV GOPROXY=https://proxy.golang.org,direct

WORKDIR /src

RUN set -eux; \
    mkdir -p /src/deplao; \
    curl \
      -fL \
      --retry 8 \
      --retry-all-errors \
      --retry-delay 5 \
      --connect-timeout 30 \
      --max-time 300 \
      "https://codeload.github.com/babyvibe/deplao-builder/tar.gz/refs/tags/${DEPLAO_REF}" \
      -o /tmp/deplao.tar.gz; \
    tar -xzf /tmp/deplao.tar.gz \
      --strip-components=1 \
      -C /src/deplao; \
    rm -f /tmp/deplao.tar.gz

WORKDIR /src/deplao/src/bridge-e2ee

# ------------------------------------------------------------
# go.mod uses local ./meta.
#
# Download mautrix/meta snapshot directly instead of git fetch.
# ------------------------------------------------------------
RUN set -eux; \
    rm -rf ./meta; \
    mkdir -p ./meta; \
    curl \
      -fL \
      --retry 8 \
      --retry-all-errors \
      --retry-delay 5 \
      --connect-timeout 30 \
      --max-time 300 \
      "https://codeload.github.com/mautrix/meta/tar.gz/${MAUTRIX_META_REF}" \
      -o /tmp/meta.tar.gz; \
    tar -xzf /tmp/meta.tar.gz \
      --strip-components=1 \
      -C ./meta; \
    rm -f /tmp/meta.tar.gz

# ------------------------------------------------------------
# Download Go dependencies with retry.
# ------------------------------------------------------------
RUN set -eux; \
    attempt=1; \
    while [ "$attempt" -le 5 ]; do \
      if go mod download; then \
        break; \
      fi; \
      if [ "$attempt" -eq 5 ]; then \
        echo "go mod download failed after 5 attempts"; \
        exit 1; \
      fi; \
      echo "go mod download failed - retry $attempt/5"; \
      sleep $((attempt * 10)); \
      attempt=$((attempt + 1)); \
    done

# ------------------------------------------------------------
# Build Facebook E2EE bridge.
# ------------------------------------------------------------
RUN set -eux; \
    mkdir -p /out; \
    CGO_ENABLED=0 go build \
      -trimpath \
      -ldflags="-s -w" \
      -o /out/fbchat-bridge-e2ee .

# ============================================================
# Runtime
# ============================================================

FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3200 \
    DATA_DIR=/app/data \
    FBCHAT_E2EE_BIN=/app/bin/fbchat-bridge-e2ee

COPY services/facebook-connector/package.json ./package.json
COPY services/facebook-connector/server.js ./server.js
COPY services/facebook-connector/supervisor.js ./supervisor.js

COPY --from=bridge-builder \
    /out/fbchat-bridge-e2ee \
    /app/bin/fbchat-bridge-e2ee

RUN mkdir -p /app/data /app/tmp \
    && chown -R node:node /app

USER node

EXPOSE 3200

CMD ["node", "supervisor.js"]